{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "croo",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "croo.space/*",
      "zone_name": "croo.space"
    }
  ]
}
